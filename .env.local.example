# Crucible (Wu-Weism / synthesis-engine) — local environment template
# Copy this file to `.env.local` and fill in real values. `.env.local` is gitignored.
# Derived from actual process.env references in src/. Grouped by necessity.

# ─────────────────────────────────────────────────────────────
# REQUIRED — Supabase (auth, persistence, claim/governance ledgers)
# Create a project at https://supabase.com, then copy from Project Settings → API.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Service role key is used by server-admin paths and migrations. Keep it secret; server-only.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ─────────────────────────────────────────────────────────────
# REQUIRED for chat / synthesis / epistemic AI paths — at least ONE provider
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Provider selection (defaults exist in code; set to steer routing)
AI_PROVIDER_DEFAULT=
AI_PROVIDER_ADVANCED=
# FORCE_PROVIDER=          # optional: pin a single provider

# ─────────────────────────────────────────────────────────────
# OPTIONAL — web grounding / search
# ─────────────────────────────────────────────────────────────
BRAVE_API_KEY=

# ─────────────────────────────────────────────────────────────
# OPTIONAL — app + misc
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# AI_DEBUG=false
# Feature flags (safe defaults in code; enable deliberately):
# SCIENTIFIC_INTEGRITY_GATE_ENABLED=false
# CAUSAL_LITERACY_ENABLED=false
# DISAGREEMENT_ENGINE_ENABLED=false
# PHENOMENAL_LAYER_ENABLED=false
# SCM_HYPOTHESIS_ENABLED=false
